{
  "name": "sign-window",
  "version": "1.0.0",
  "private": true,
  "description": "Embeddable accessible Ethiopian Sign Language lesson player.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/vtt.test.js test/transcript.test.js test/timeline.test.js test/api.test.js",
    "a11y": "playwright test",
